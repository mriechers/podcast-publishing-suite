# ═══════════════════════════════════════════════════════════════════════
# PRX-to-Ghost Publisher — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════
#
# This project uses TWO environment files — .env (no suffix) is NOT used.
#
#   .env.dev   → Local Ghost (http://localhost:2368)
#   .env.prod  → Production Ghost (https://wonder-cabinet.ghost.io)
#
# To get started:
#   cp .env.example .env.dev     # then fill in your local Ghost key
#   cp .env.example .env.prod    # then fill in your prod Ghost key
#
# The --env flag selects which file is loaded (default: dev):
#   python3 -m src.main sync --env dev   → loads .env.dev
#   python3 -m src.main sync --env prod  → loads .env.prod
#   ./sync_feeds.sh --env prod            → loads .env.prod
#
# ═══════════════════════════════════════════════════════════════════════

# Ghost CMS Configuration
GHOST_URL=http://localhost:2368
GHOST_ADMIN_API_KEY=your_key_id:your_secret_hex
# Public site URL (for PRX writeback canonical links; defaults to GHOST_URL)
# GHOST_SITE_URL=https://wondercabinetproductions.com

# PRX Feed Configuration (RSS)
PRX_FEED_URL=https://feeds.ttbook.org/ttbook

# PRX Dovetail API Configuration
# Get credentials from PRX: https://prx.org
PRX_CLIENT_ID=your_prx_client_id
PRX_CLIENT_SECRET=your_prx_client_secret
PRX_PODCAST_ID=120
# Multiple podcasts: comma-separated list (overrides PRX_PODCAST_ID)
# 120 = TTBOOK main feed, 3329 = Luminous
PRX_PODCAST_IDS=120,3329

# Optional: Override API endpoints (defaults shown)
# PRX_API_BASE_URL=https://podcasts.dovetail.prx.org/api/v1
# PRX_ID_BASE_URL=https://id.prx.org

# Set to true to use Dovetail API instead of RSS by default
PRX_USE_API=false

# Publishing defaults
PUBLISH_STATUS=draft
DRY_RUN=false
